# =============================================================================
# DementiaVoiceAI — .gitignore
# =============================================================================

# ----------------------------- Python Bytecode --------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyo

# ----------------------------- Build / Packaging ------------------------------
build/
dist/
wheels/
*.egg-info/
*.egg
*.whl
*.tar.gz
*.zip
sdist/
MANIFEST

# ----------------------------- Virtual Environments ---------------------------
.venv/
venv/
env/
mlvenv/
.env/
ENV/
.python-version

# ----------------------------- Audio Data (Privacy) ---------------------------
# NEVER commit raw audio / patient data
data/raw/
data/dementia/
data/non_dementia/
data/processed/audio/
data/processed/features/
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac
*.wma
*.aiff

# Feature cache (large CSV regenerated by pipeline)
data/features_cache.csv

# ----------------------------- Model Checkpoints (Binary) ---------------------
saved_models/**/*.pt
saved_models/**/*.pth
saved_models/**/*.pkl
saved_models/**/*.joblib
saved_models/**/*.onnx
saved_models/**/*.h5

# ----------------------------- Results (Generated) ----------------------------
results/plots/*.png
results/plots/*.jpg
results/plots/*.svg
results/plots/*.pdf
results/metrics/*.json

# ----------------------------- Documents / Reports ----------------------------
*.pdf
*.docx
*.doc
*.pptx
*.ppt
*.xlsx
*.xls

# ----------------------------- Jupyter Notebooks ------------------------------
.ipynb_checkpoints/

# ----------------------------- IDE / Editor -----------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----------------------------- OS Artifacts -----------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk
ehthumbs.db
ehthumbs_vista.db

# ----------------------------- Logs -------------------------------------------
logs/
app/logs/
*.log

# ----------------------------- Temp / Cache -----------------------------------
temp/
tmp/
*.tmp
*.bak
*.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# ----------------------------- Miscellaneous ----------------------------------
*.sqlite3
*.db
.env
.env.*
!.env.example
*.orig
*.rej
node_modules/

# ----------------------------- Scratch / Test Scripts -------------------------
test_mermaid.py
test_mermaid.html
temp/
